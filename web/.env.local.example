# Development only.
#
# `npm run dev` serves the UI on :3000 while Flask runs on :5000, so the
# browser has to be told where the API lives. Copy this file to
# `.env.local` before running the dev server.
#
# Leave it unset for `npm run build` — the static export is served by
# Flask itself, where /analyse is same-origin.
NEXT_PUBLIC_API_BASE=http://localhost:5000

# Optional, development only: serve a canned result from the audio
# workbench instead of calling POST /analyse-audio, so the UI works
# before the backend does. Results are deterministic per file and the
# report shows a "MOCK DATA" badge. Leave unset (or anything but "1")
# for real analysis, and never set it for `npm run build`.
# NEXT_PUBLIC_AUDIO_MOCK=1
