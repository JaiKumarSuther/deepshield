# Development only.
#
# `npm run dev` serves the UI on :3000 while Flask runs on :5000, so the
# browser has to be told where the API lives. Copy this file to
# `.env.local` before running the dev server.
#
# Leave it unset for `npm run build` — the static export is served by
# Flask itself, where /analyse is same-origin.
NEXT_PUBLIC_API_BASE=http://localhost:5000
